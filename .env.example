# =============================================================================
# TyronaWilds (PlataformaTurismoSM) - Variables de Entorno Backend & Docker
# Copia este archivo como `.env` para despliegues locales o de producción.
# NUNCA subas archivos `.env` reales al repositorio (bloqueados por .gitignore).
# =============================================================================

# Base de Datos PostgreSQL 16 + pgvector (Database-per-Service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
DB_IDENTIDAD_USER=postgres
DB_IDENTIDAD_PASSWORD=postgres_password
DB_OFERTA_USER=postgres
DB_OFERTA_PASSWORD=postgres_password
DB_RESERVAS_USER=postgres
DB_RESERVAS_PASSWORD=postgres_password
DB_RECOMENDACION_USER=postgres
DB_RECOMENDACION_PASSWORD=postgres_password
DB_INDICADORES_USER=postgres
DB_INDICADORES_PASSWORD=postgres_password
DB_AUDITORIA_USER=postgres
DB_AUDITORIA_PASSWORD=postgres_password

# Caché Distribuida Redis 7
REDIS_HOST=localhost
REDIS_PORT=6379

# Broker de Mensajería RabbitMQ 3.13
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Seguridad JWT (HMAC-SHA256 >= 256 bits) y CORS Estricto en API Gateway
JWT_SECRET=TyronaWildsClaveSecretaDeGradoMilitarParaFirmaJwtHmacSha256UniversidadDelMagdalena2026
JWT_EXPIRATION_MS=86400000
ALLOWED_ORIGINS=http://localhost:3000,https://tyronawilds.vercel.app

# Puntos de Variabilidad Arquitectónica (Laboratorio 3 - Punto 5.2)
AUTH_PROVEEDORES=local,google
RECOMENDACION_NIVEL=PERSONALIZADO
